# Postgres connection (Neon, Vercel Postgres, or Supabase all work).
# DATABASE_URL: the pooled connection string. DIRECT_URL: the direct (non-pooled) one.
# If your provider gives only one URL, paste the same value into both.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roomaster"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/roomaster"

# Password for /admin
ADMIN_PASSWORD="@Reagan230okoth"

# Random strings, e.g. generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-random-string"
IP_HASH_SALT="replace-with-another-random-string"
